{
  "name": "poe-smith",
  "productName": "PoESmith",
  "version": "0.3.1",
  "private": true,
  "description": "PoESmith: Path of Exile crafting and market overlay",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "node scripts/release.mjs"
  },
  "build": {
    "appId": "io.github.nightievvv.poesmith",
    "productName": "PoESmith",
    "artifactName": "PoESmith-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Nightievvv",
        "repo": "poe-smith",
        "releaseType": "release"
      }
    ],
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.8"
  }
}
